diff --git a/qemu/overlay/hw/audio/jz4740_aic.c b/qemu/overlay/hw/audio/jz4740_aic.c
index d103119..fbffac0 100644
--- a/qemu/overlay/hw/audio/jz4740_aic.c
+++ b/qemu/overlay/hw/audio/jz4740_aic.c
@@ -528,6 +528,14 @@ static void jz4740_aic_flush_stream(JZ4740AICState *s)
     s->stream_frames = 0;
 }
 
+static int16_t jz4740_aic_scale_sample(int16_t sample, unsigned volume)
+{
+    int32_t scaled = (int32_t)sample * (int32_t)volume / 255;
+
+    return scaled > INT16_MAX ? INT16_MAX :
+           scaled < INT16_MIN ? INT16_MIN : scaled;
+}
+
 static void jz4740_aic_stream_output(JZ4740AICState *s,
                                      const int16_t *samples,
                                      uint32_t frames)
@@ -550,7 +558,7 @@ static void jz4740_aic_stream_output(JZ4740AICState *s,
         int16_t *dest = &s->stream_samples[s->stream_frames * 2u];
 
         for (uint32_t i = 0; i < count * 2u; i++) {
-            dest[i] = muted ? 0 : ((int32_t)samples[i] * volume) / 255;
+            dest[i] = muted ? 0 : jz4740_aic_scale_sample(samples[i], volume);
         }
         s->stream_frames += count;
         samples += count * 2u;
